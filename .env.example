# HubSpot private app token (Settings > Integrations > Private Apps)
# Scopes: crm.objects.contacts.read, crm.objects.contacts.write, crm.schemas.contacts.write
HUBSPOT_TOKEN=

# Shared secret the member portal uses to sign its webhooks
PORTAL_WEBHOOK_SECRET=

# Only needed for inbound HubSpot webhooks (app client secret)
HUBSPOT_CLIENT_SECRET=

# Public URL HubSpot calls, used to verify v3 signatures
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000
